{
  "name": "enrollment-dss",
  "version": "0.1.0",
  "productName": "Enrollment Forecasting DSS",
  "desktopName": "enrollment-forecasting-dss.desktop",
  "description": "Enrollment Forecasting DSS desktop app",
  "homepage": "https://github.com/Jetrossgalinato/dss-app",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jetrossgalinato/dss-app.git"
  },
  "main": "./out/main/index.js",
  "author": "dss-app",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:compat": "DSS_DISABLE_GPU=1 electron-vite dev -- --no-sandbox",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "build:icon": "node scripts/generate-icon.mjs",
    "build:backend": "cd ../backend && uv run --group desktop pyinstaller --clean --noconfirm desktop.spec",
    "dist:win": "npm run build:icon && npm run build:backend && npm run build && electron-builder --config electron-builder.yml --win nsis --x64",
    "dist:linux": "npm run build:icon && npm run build:backend && npm run build && electron-builder --config electron-builder.yml --linux AppImage deb --x64"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "chart.js": "^4.5.1",
    "vue": "^3.5.13",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^4.6.4",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.14",
    "@types/node": "^22.13.10",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.0.0",
    "tailwindcss": "^4.0.14",
    "typescript": "^5.8.2",
    "vite": "^6.2.1",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.2.8"
  },
  "allowScripts": {
    "electron@44.4.1": true,
    "esbuild@0.25.12": true
  }
}
